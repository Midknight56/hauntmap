{
  "name": "hauntmap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:devhook": "vite build --mode devhook --outDir dist-devhook",
    "preview": "vite preview",
    "verify:e2e": "pnpm build && pnpm build:devhook && playwright test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "pack:samples": "tsx scripts/pack-samples.ts",
    "check:expected": "node scripts/check-expected.mjs",
    "build:mcp": "pnpm --filter hauntmap-mcp build",
    "hauntmap": "node packages/hauntmap-mcp/bin/hauntmap.js",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:live": "tsx scripts/demo-live.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm pack:samples --check && pnpm check:expected"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@babel/parser": "8.1.2",
    "@dagrejs/dagre": "3.1.3",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}